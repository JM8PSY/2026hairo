# 親機 ROS ゲートウェイ。tools/install_services.sh が @USER@ / @REPO@ を置き換えて /etc/systemd/system に入れる
[Unit]
Description=Hairo robot ROS gateway (map, pose, sensor switches)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && exec python3 @REPO@/parent/server/gateway.py --config @REPO@/parent/config/gateway.json'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
