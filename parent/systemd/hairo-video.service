# 親機 映像サーバー。tools/install_services.sh が @USER@ / @REPO@ を置き換えて /etc/systemd/system に入れる
[Unit]
Description=Hairo robot parent video server (MJPEG passthrough)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@REPO@
ExecStart=/usr/bin/python3 @REPO@/parent/server/video.py --config @REPO@/parent/config/video.json
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
