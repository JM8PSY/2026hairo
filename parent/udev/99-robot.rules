# 親機のシリアルデバイス名を固定する（CLAUDE.md §4, §7）
# ESP32-DevKit と YD-LiDAR X4 Pro はどちらも USB-シリアル変換に CP210x を使うことがあり、
# VID/PID だけでは区別できない。シリアル番号（使えなければ USB ポートの位置）で識別すること。
# シリアル番号の調べ方: udevadm info -a -n /dev/ttyUSB0 | grep '{serial}'
# 実機の値に書き換えたら `sudo ./tools/setup_jetson.sh --no-ros --no-pio` で再インストールする。

# モーター駆動 ESP32 → /dev/robot_mcu
SUBSYSTEM=="tty", ATTRS{serial}=="CHANGE_ME_ESP32_SERIAL", SYMLINK+="robot_mcu", MODE="0660", GROUP="dialout"

# YD-LiDAR X4 Pro → /dev/ydlidar
# 実機の CP2102 のシリアル番号は既定値らしい 0001 で識別に使えないため、USB ポートの位置で識別する。
# 別のポートに挿すと /dev/ydlidar は作られない。調べ方: udevadm info -q property /dev/ttyUSB0 | grep ID_PATH=
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-3610000.usb-usb-0:2.1:1.0", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", SYMLINK+="ydlidar", MODE="0660", GROUP="dialout"
